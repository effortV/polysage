# ---- 文献 / 专利 API ----
OPENALEX_API_KEY=
OPENALEX_MAILTO=
ELSEVIER_API_KEY=
# 可选：Elsevier 机构令牌（校园网外访问全文时需要）
ELSEVIER_INSTTOKEN=
# Unpaywall 需要一个联系邮箱（免费）
UNPAYWALL_EMAIL=
# 可选：Semantic Scholar API key（无 key 也可低频使用）
SEMANTIC_SCHOLAR_API_KEY=
# 可选：Tavily 网页搜索（未配置时使用免费 DuckDuckGo）
TAVILY_API_KEY=
# 可选：参考价自动网查刷新周期（天）；0 或留空 = 关闭，只手动刷新
PRICE_AUTO_REFRESH_DAYS=
# 访问口令：设置后打开网页先输口令（tunnel.ps1 对外网开放前要求必须设置）
APP_PASSWORD=
# 可选：Cloudflare 命名隧道令牌（固定域名）；留空则 tunnel.ps1 用临时随机网址
CLOUDFLARE_TUNNEL_TOKEN=

# ---- 硅基流动 SiliconFlow（OpenAI 兼容）----
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Pro
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- 对话模型切换：siliconflow（默认）| zju ----
LLM_PROFILE=siliconflow
ZJU_BASE_URL=https://api.zjumembrane.cn/v1
ZJU_API_KEY=
ZJU_CHAT_MODEL=zju-qwen
# zju 服务是否支持 enable_thinking 参数（不确定填 0）
ZJU_SUPPORTS_THINKING=0
